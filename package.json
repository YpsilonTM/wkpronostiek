{
	"name": "wkpronostiek",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --bun run vite dev",
		"build": "svelte-kit sync && bunx --bun prisma generate && bun --bun run vite build && bun run build:auth-helper",
		"build:auth-helper": "bun build scripts/node-auth-login.ts --outfile scripts/node-auth-login.mjs --target node --format esm --external playwright",
		"preview": "bun --bun run vite preview",
		"start": "bun ./build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"typecheck": "bun run check",
		"lint": "biome check .",
		"format": "biome format --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "bunx --bun prisma generate",
		"db:migrate": "bunx --bun prisma migrate dev",
		"db:migrate:deploy": "bunx --bun prisma migrate deploy",
		"db:import-legacy": "bun run scripts/import-legacy-data.ts"
	},
	"dependencies": {
		"@google/genai": "^2.8.0",
		"@libsql/client": "^0.17.4",
		"@prisma/adapter-libsql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"croner": "^10.0.1",
		"dotenv": "^17.4.2",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"playwright": "1.61.0",
		"prisma": "^7.8.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.0",
		"@sveltejs/kit": "^2.65.2",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@types/bun": "^1.3.14",
		"svelte": "^5.56.3",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^3.2.4"
	}
}
