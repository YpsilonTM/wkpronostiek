generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model AuthToken {
  id            String   @id @default("pronotool")
  authorization String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Prediction {
  id                 Int      @id @default(autoincrement())
  matchId            Int
  homeTeam           String?
  awayTeam           String?
  phaseName          String?
  startTime          String?
  homeScore          Int
  awayScore          Int
  shootoutWinner     Int?
  reasoning          String   @default("")
  searchAnalysis     String   @default("")
  model              String?
  escalated          Boolean  @default(false)
  tactic             String?
  mirroredFromUserId String?
  mirroredFromRank   Int?
  submittedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([matchId])
  @@index([submittedAt])
}

model MigrationMeta {
  id                  String   @id @default("legacy")
  legacyImportAt      DateTime @default(now())
  predictionsImported Int      @default(0)
  authImported        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
