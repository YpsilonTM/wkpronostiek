# Gemini API key (verplicht voor AI-voorspellingen)
GEMINI_API_KEY=your-gemini-api-key

# Optioneel: Gemini modellen (default: gemini-3.5-flash / gemini-3.1-pro-preview bij lage zekerheid)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_ESCALATION_MODEL=gemini-3.1-pro-preview

# Optioneel: pad naar legacy JSONL voor import (default: .prediction_log.jsonl in data dir)
# PREDICTION_LOG_FILE=.prediction_log.jsonl

# Optioneel: overschrijf data map
# - lokaal (default): projectmap (cwd) — geen DATA_DIR nodig
# - Docker: /app/data (ingesteld in image; mount een volume op /app/data)
# DATA_DIR=./data

# Optioneel: SQLite connection string (meestal niet nodig — wordt afgeleid uit DATA_DIR)
# - lokaal (default): file:./wkpronostiek.db in cwd
# - Docker (default): file:/app/data/wkpronostiek.db
# DATABASE_URL=file:./wkpronostiek.db

# VRT credentials (voor browser login fallback)
VRT_EMAIL=your-email@example.com
VRT_PASSWORD=your-password

# Optioneel: directe bearer token, dan is browser login niet nodig
# PRONOTOOL_AUTHORIZATION=

# Optioneel: headless browser tonen bij login (default true)
# HEADLESS=true
