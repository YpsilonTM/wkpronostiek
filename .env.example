# Gemini API key (verplicht voor AI-voorspellingen)
GEMINI_API_KEY=your-gemini-api-key

# VRT credentials (voor browser login fallback)
VRT_EMAIL=your-email@example.com
VRT_PASSWORD=your-password

# Optioneel: directe bearer token, dan is browser login niet nodig
# PRONOTOOL_AUTHORIZATION=

# Optioneel: headless browser tonen bij login (default true)
# HEADLESS=true
